# Copy to .env and fill in real values before running docker-compose.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

DJANGO_DEBUG=false

# Comma-separated. Include the hostname you'll expose via Cloudflare Tunnel.
DJANGO_ALLOWED_HOSTS=resume.yourdomain.com,localhost,127.0.0.1

# Comma-separated, must include scheme. Required for portal form POSTs to
# pass CSRF checks when accessed through your public hostname.
DJANGO_CSRF_TRUSTED_ORIGINS=https://resume.yourdomain.com

# Leave true when running behind Cloudflare Tunnel / a reverse proxy.
DJANGO_BEHIND_PROXY=true

DJANGO_TIME_ZONE=America/Chicago

# Cookies are marked "Secure" (HTTPS-only) by default once DJANGO_DEBUG=false,
# which is correct once Cloudflare Tunnel is fronting this with TLS. If you
# need to test directly over plain http:// before the tunnel is set up,
# temporarily set this to false — then remove it (or set true) once you're
# accessing the site over https:// for real.
# DJANGO_COOKIE_SECURE=false
